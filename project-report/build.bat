@echo off
setlocal EnableExtensions
cd /d "%~dp0"

set "PLACEHOLDERS=0"
set "CLEAN=0"

:parse_args
if "%~1"=="" goto run
if /I "%~1"=="--placeholders" set "PLACEHOLDERS=1" & shift & goto parse_args
if /I "%~1"=="--clean" set "CLEAN=1" & shift & goto parse_args
if /I "%~1"=="-h" goto help
if /I "%~1"=="--help" goto help
echo Unknown option: %~1
exit /b 1

:help
echo Usage: build.bat [--placeholders] [--clean]
echo   Compiles main.tex to main.pdf
exit /b 0

:run
where pdflatex >nul 2>&1
if errorlevel 1 (
  echo Error: pdflatex not found. Install MiKTeX or TeX Live and add to PATH.
  echo   https://miktex.org/download
  exit /b 1
)

if not exist "pes_logo.png" (
  if "%PLACEHOLDERS%"=="1" (
    python -c "import sys; from pathlib import Path; PNG=bytes([0x89,0x50,0x4E,0x47,0x0D,0x0A,0x1A,0x0A,0x00,0x00,0x00,0x0D,0x49,0x48,0x44,0x52,0x00,0x00,0x00,0x01,0x00,0x00,0x00,0x01,0x08,0x02,0x00,0x00,0x00,0x90,0x77,0x53,0xDE,0x00,0x00,0x00,0x0C,0x49,0x44,0x41,0x54,0x08,0xD7,0x63,0xF8,0xCF,0xC0,0x00,0x00,0x03,0x01,0x01,0x00,0x18,0xDD,0x8D,0xB4,0x00,0x00,0x00,0x00,0x49,0x45,0x4E,0x44,0xAE,0x42,0x60,0x82]); Path('pes_logo.png').write_bytes(PNG)" 2>nul
    if errorlevel 1 echo Warning: missing pes_logo.png - add file or install Python for --placeholders
  ) else (
    echo Warning: missing pes_logo.png
  )
)

if not exist "system_architecture.png" (
  if "%PLACEHOLDERS%"=="1" (
    python -c "import sys; from pathlib import Path; PNG=bytes([0x89,0x50,0x4E,0x47,0x0D,0x0A,0x1A,0x0A,0x00,0x00,0x00,0x0D,0x49,0x48,0x44,0x52,0x00,0x00,0x00,0x01,0x00,0x00,0x00,0x01,0x08,0x02,0x00,0x00,0x00,0x90,0x77,0x53,0xDE,0x00,0x00,0x00,0x0C,0x49,0x44,0x41,0x54,0x08,0xD7,0x63,0xF8,0xCF,0xC0,0x00,0x00,0x03,0x01,0x01,0x00,0x18,0xDD,0x8D,0xB4,0x00,0x00,0x00,0x00,0x49,0x45,0x4E,0x44,0xAE,0x42,0x60,0x82]); Path('system_architecture.png').write_bytes(PNG)" 2>nul
    if errorlevel 1 echo Warning: missing system_architecture.png
  ) else (
    echo Warning: missing system_architecture.png
  )
)

where latexmk >nul 2>&1
if not errorlevel 1 (
  echo Building with latexmk...
  latexmk -pdf -interaction=nonstopmode -file-line-error main.tex
  if "%CLEAN%"=="1" latexmk -c main.tex >nul 2>&1
  goto done
)

echo Building with pdflatex...
pdflatex -interaction=nonstopmode -file-line-error main.tex
pdflatex -interaction=nonstopmode -file-line-error main.tex

if "%CLEAN%"=="1" del /q main.aux main.log main.out main.toc main.lof main.lot 2>nul

:done
if exist "main.pdf" (
  echo.
  echo Success: %CD%\main.pdf
  exit /b 0
)

echo Error: main.pdf was not produced.
exit /b 1
